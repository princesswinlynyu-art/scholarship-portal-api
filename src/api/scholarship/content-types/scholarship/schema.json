    },
    "description": {
      "type": "richtext"
    },
    "eligibilty": {
      "type": "richtext"
    },
    "stat": {
      "type": "enumeration",
      "enum": [
        "Open",
        "Closed"
      ]
    },
    "applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::application.application",
      "mappedBy": "scholarship"
    }
  }
